    "G7_ASSISTED_WORKFLOWS": {
      "name": "Optional offline assistance",
      "required": true,
      "pass_condition": "Tracing, dimension extraction, label placement, and natural-language assistance work offline, visibly distinguish suggestions, require acceptance, preserve provenance, and never become a deterministic workflow dependency.",
      "requirement_ids": [
        "ASSIST-001",
        "ASSIST-002",
        "ASSIST-003",
        "ASSIST-004",
        "ASSIST-005"
      ]
    },
    "G8_INTERCHANGE_OUTPUT": {
      "name": "Interchange, print, and output fidelity",
      "required": true,
      "pass_condition": "Declared IFC, DXF, PDF/raster, preview, SVG, print, page-size, scale, and stale-output rules pass with explicit fidelity reports.",
      "requirement_ids": [
        "COMP-IO-003",
        "APX-DOC-002",
        "APX-DOC-003",
        "IO-IFC-001",
        "IO-DXF-001",
        "IO-PDF-001",
        "IO-OUTPUT-001",
        "IO-OUTPUT-002",
        "IO-OUTPUT-003"
      ]
    },
    "G9_OFFLINE_SECURITY": {
      "name": "Offline operation and import security",
      "required": true,
      "pass_condition": "Offline installation and core workflows work without entitlement or network services, and untrusted imports and coordinate resources meet the Windows isolation and no-download contract.",
      "requirement_ids": [
        "CORE-OFF-001",
        "CORE-OFF-002",
        "CORE-OFF-003",
        "SEC-WORKER-001",
        "SEC-WORKER-002",
        "SEC-PROJ-001"
      ]
    },
    "G10_QUALITY_PACKAGING": {
      "name": "Production quality, performance, and handoff artifacts",
      "required": true,
      "pass_condition": "Performance, correctness, integrated residential and light-commercial workflows, real input/accessibility checks, offline packages, source/build kit, help, notices, SBOM, fixtures, and verification reports pass.",
