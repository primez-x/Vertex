        "APX-AREA-003",
        "APX-AREA-004"
      ]
    },
    "G5_APEX_PARITY": {
      "name": "Apex workflow, library, tracing, field, and specialist parity",
      "required": true,
      "pass_condition": "All documented Apex 7 workflows and capability categories, including both drawing modes, libraries, tracing, multipage documents, workspace controls, field input, survey, georeferencing, and output behavior, pass parity fixtures.",
      "requirement_ids": [
        "APX-WF-001",
        "APX-WF-002",
        "APX-WF-003",
        "APX-KEY-003",
        "APX-ANNO-001",
