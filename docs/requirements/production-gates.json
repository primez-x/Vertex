{
  "schema_version": "1.0",
  "gate_set_id": "offline-measurement-architectural-production",
  "purpose": "One mandatory production acceptance path for every requirement in apex-parity.json.",
  "gates": {
    "G1_BASELINE_EVIDENCE": {
      "name": "Apex baseline and compatibility evidence",
      "required": true,
      "pass_condition": "The exact Apex editions/modules, native files, devices, caller protocols, representative projects, and expected outputs are observed and their compatibility fixtures pass.",
      "requirement_ids": [
        "APX-INPUT-002",
        "APX-INT-001",
        "APX-INT-002",
        "APX-NATIVE-AX5-001",
        "APX-NATIVE-AX7-001",
        "APX-NATIVE-LEGACY-001",
        "APX-COMPAT-001",
        "APX-COMPAT-002"
      ]
    },
    "G2_COMPONENTS_LICENSE": {
      "name": "Qualified components and licensing",
      "required": true,
      "pass_condition": "Every exact shipped dependency and build option is qualified for Windows, offline use, isolation, provenance, and its license obligations; no prohibited baseline dependency remains.",
      "requirement_ids": [
        "COMP-LIC-001",
        "COMP-LIC-002",
        "COMP-LIC-003",
        "COMP-GEO-001",
        "COMP-GEO-002",
        "COMP-IO-001",
        "COMP-IO-002"
      ]
    },
    "G3_DOCUMENT_INTEGRITY": {
      "name": "Document authority, persistence, and recovery integrity",
      "required": true,
      "pass_condition": "Semantic authority, typed links, immutable snapshots, output fingerprints, command transactions, precision, migration, recovery, revision comparison, portability, and adapter contracts pass integrity tests.",
      "requirement_ids": [
        "CORE-OWN-002",
        "CORE-DOC-001",
        "CORE-DOC-002",
        "CORE-DOC-003",
        "CORE-DOC-004",
        "CORE-DOC-005",
        "CORE-DOC-006",
        "CORE-DOC-007",
        "CORE-DOC-008",
        "CORE-DOC-009",
        "CORE-DOC-010",
        "REC-001",
        "REC-002",
        "REC-003",
        "REC-004"
      ]
    },
    "G4_GEOMETRY_CONSTRAINTS": {
      "name": "Precision geometry, constraints, editing, and calculations",
      "required": true,
      "pass_condition": "Analytical geometry, curves, precision entry, snapping, constraints, conflict behavior, topology, undoable editing, and inspectable area calculations pass independent fixtures.",
      "requirement_ids": [
        "GEO-BASE-001",
        "GEO-BASE-002",
        "GEO-BASE-003",
        "GEO-BASE-004",
        "GEO-CON-001",
        "GEO-CON-002",
        "GEO-CON-003",
        "GEO-CON-004",
        "GEO-CON-005",
        "GEO-CON-006",
