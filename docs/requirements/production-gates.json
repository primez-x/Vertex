      "name": "Full architectural authoring and modern workspace",
      "required": true,
      "pass_condition": "Both workspaces, full residential/light-commercial architectural authoring, editable 3D, coordinated views, schedules, sheets, remodeling alternatives, contextual UI, themes, and accessibility pass integrated fixtures.",
      "requirement_ids": [
        "CORE-SCOPE-001",
        "CORE-SCOPE-002",
        "ARCH-MOD-001",
        "ARCH-MOD-002",
        "ARCH-MOD-003",
